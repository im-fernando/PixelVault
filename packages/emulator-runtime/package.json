{
  "name": "@pixelvault/emulator-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "verify:browser": "node verificacao/verificar.mjs",
    "verify:audio": "node verificacao/verificar-audio.mjs"
  },
  "dependencies": {
    "@pixelvault/contracts": "workspace:*",
    "nostalgist": "0.22.0"
  },
  "devDependencies": {
    "@pixelvault/config": "workspace:*",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
