// Schema do PixelVault.
//
// Um schema só, com chaves estrangeiras de verdade. A fronteira entre
// módulos é imposta no código (dependency-cruiser), não no banco: abrir
// mão de integridade referencial em troca de uma independência que não
// vamos usar seria mau negócio. Ver docs/adr/0003.

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

/// Consoles suportados. Espelha SystemId em @pixelvault/contracts.
enum SystemId {
  snes
  nes
  gb
  gba
  genesis
}

/// Papel da conta. Dois valores e nada além disso: o produto não tem
/// moderação nem time, e papel que ninguém usa vira permissão esquecida.
/// Ver docs/adr/0018 e issue #48.
enum Role {
  user
  admin
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String   @map("password_hash")
  displayName     String   @map("display_name")
  handle          String   @unique
  /// Padrão seguro: toda conta nasce `user`. Virar `admin` é operação
  /// manual, deliberada — não existe caminho de aplicação que promova
  /// alguém.
  role            Role     @default(user)
  /// Quando a pessoa aceitou os termos de uso. Exigência de LGPD: o
  /// consentimento precisa ser demonstrável, e quem carimba é o relógio do
  /// servidor — nunca um timestamp vindo do cliente. Ver issue #45.
  termsAcceptedAt DateTime @map("terms_accepted_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  userGames           UserGame[]
  userRoms            UserRom[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// Sessão de login. Ver docs/adr/0017: token guardado como hash, nunca em
/// claro — um dump desta tabela não deve virar sequestro de sessão.
model Session {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  userAgent   String?  @map("user_agent")
  ipTruncated String?  @map("ip_truncated")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Token de redefinição de senha. Tabela própria, e não uma linha em
/// `sessions`, porque os dois conceitos são opostos: uma sessão autentica
/// quem JÁ provou saber a senha; este token É a prova, e vale uma vez só.
/// Reaproveitar a tabela faria um token de e-mail valer como cookie de
/// sessão — e a limpeza de um passaria a mexer no outro.
///
/// `tokenHash` é o SHA-256 do token que foi para o e-mail; o valor em claro
/// não existe em lugar nenhum do servidor depois do envio. Mesmo raciocínio
/// do `token_hash` de `sessions` (docs/adr/0017): um dump desta tabela não
/// pode virar redefinição de senha alheia.
model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Invalidar todos os tokens de uma conta depois de uma redefinição.
  @@index([userId])
  /// Poda preguiçosa por idade, que não passa por conta nenhuma.
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model System {
  id        SystemId @id
  name      String
  /// Slug do core de emulação usado por este sistema.
  coreSlug  String   @map("core_slug")
  createdAt DateTime @default(now()) @map("created_at")

  games Game[]

  @@map("systems")
}

/// Catálogo canônico de metadados — o eixo de conquistas, ranking e perfil.
/// Nunca guarda arquivo de ROM comercial: metadado é redistribuível, ROM não.
model Game {
  id          String   @id @default(uuid()) @db.Uuid
  systemId    SystemId @map("system_id")
  title       String
  slug        String   @unique
  releaseYear Int?     @map("release_year")
  publisher   String?
  coverUrl    String?  @map("cover_url")
  /// Homebrew é jogável por qualquer pessoa, sem login e sem upload.
  isHomebrew  Boolean  @default(false) @map("is_homebrew")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  system    System     @relation(fields: [systemId], references: [id])
  roms      GameRom[]
  userGames UserGame[]
  userRoms  UserRom[]

  @@index([systemId])
  @@index([isHomebrew])
  @@map("games")
}

/// Hashes conhecidos por jogo. É o que permite o match do BYOR: o usuário
/// sobe a ROM, casamos o SHA-256 aqui e a capa aparece sozinha.
model GameRom {
  id         String  @id @default(uuid()) @db.Uuid
  gameId     String  @map("game_id") @db.Uuid
  sha256     String  @unique
  region     String?
  revision   String?
  /// Preenchido só para homebrew, que podemos distribuir.
  storageKey String? @map("storage_key")
  sizeBytes  Int?    @map("size_bytes")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_roms")
}

/// A ROM enviada pelo usuário. Privada dele. `gameId` é nulo enquanto o
/// hash não casar com nada do catálogo — a biblioteca funciona mesmo sem
/// reconhecer o jogo.
model UserRom {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  gameId     String?  @map("game_id") @db.Uuid
  sha256     String
  storageKey String   @map("storage_key")
  sizeBytes  Int      @map("size_bytes")
  fileName   String   @map("file_name")
  /// Favorito é do CARTUCHO na estante, não do jogo do catálogo, e por isso
  /// a coluna mora aqui — a de `user_games` foi removida na #75 em vez de
  /// conviver com esta. O motivo é o BYOR: `game_id` nulo é o caso comum
  /// (ADR 0006), então favoritar por jogo não funcionaria justamente para a
  /// maioria das ROMs enviadas. Duas colunas com o mesmo nome em tabelas
  /// diferentes seriam duas versões da mesma verdade, e verdade copiada
  /// diverge.
  isFavorite Boolean  @default(false) @map("is_favorite")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)
  /// A M4: a FK composta de `user_saves` para `[userId, sha256]` exige que a
  /// ROM esteja na biblioteca antes de ter save na nuvem. Ver o model lá.
  saves UserSave[]

  @@unique([userId, sha256])
  @@index([userId])
  @@index([gameId])
  @@map("user_roms")
}

/// A relação da pessoa com um jogo do catálogo: quando jogou por último,
/// quanto tempo. `totalPlaytimeSeconds` é escrito apenas pelo servidor, a
/// partir de sessões verificadas. Ver docs/adr/0009.
///
/// Favorito saiu daqui na #75 e foi para `user_roms`: o que a pessoa
/// favorita é o cartucho que ela tem, e nem toda ROM enviada casa com um
/// jogo do catálogo. Ver o comentário da coluna lá.
model UserGame {
  userId               String    @map("user_id") @db.Uuid
  gameId               String    @map("game_id") @db.Uuid
  lastPlayedAt         DateTime? @map("last_played_at")
  totalPlaytimeSeconds Int       @default(0) @map("total_playtime_seconds")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([userId, lastPlayedAt])
  @@map("user_games")
}

/// Tipo de save guardado na nuvem. `sram` chegou na M4; `state` chega na M5
/// (issue #104) — quatro slots por ROM, cada um com miniatura própria,
/// contra o save único da SRAM.
enum SaveKind {
  sram
  state
}

/// O save da conta na nuvem (M4 para `sram`, M5 para `state`). Ao lado do
/// save local do navegador, nunca no lugar dele — a nuvem é sincronização
/// por escolha explícita, não a porta de save do player. Ver docs/adr/0020.
///
/// A FK composta `[userId, sha256]` aponta para `user_roms.[userId, sha256]`
/// (não para `users` diretamente) de propósito: exige a ROM na biblioteca da
/// própria conta antes de existir save dela na nuvem. Sem isso não há como
/// baixar e jogar em outro aparelho, que é o próprio critério de aceite da
/// milestone — um save sem ROM correspondente não serve para nada. A
/// cascata de remoção sai de graça pelo mesmo caminho: apagar a ROM da
/// biblioteca apaga o save que dependia dela, sem uma segunda relação para
/// `users` que duplicaria a mesma cascata.
///
/// `revision` é contador, não timestamp: o relógio do cliente não decide
/// conflito (ADR 0020, regra 4). `updatedAt` é `@updatedAt`, carimbado pelo
/// Prisma no momento em que o SERVIDOR grava — o cliente nunca manda esse
/// valor, e se mandar é ignorado (issue #89).
///
/// ## `slot`: sentinela `-1`, nunca `null` (issue #104)
///
/// Save state tem até 4 slots por ROM (`SaveSlot` em
/// `apps/web/.../save-key.ts`, 0 a 3); SRAM não tem slot nenhum — é o save
/// único da bateria do cartucho. A tentação óbvia era deixar `slot` nulo
/// para `sram`, mas o Postgres trata cada `NULL` como distinto dentro de um
/// índice único: duas linhas de SRAM da mesma conta e do mesmo conteúdo, com
/// `slot` nulo nas duas, NÃO colidiriam no `@@unique` abaixo — a garantia
/// que a M4 inteira depende (`buscarPorRom`/`gravar` batendo numa chave só)
/// quebraria silenciosamente sob corrida. `-1` é um inteiro de verdade, o
/// índice único o compara por igualdade normal, e a garantia volta a valer.
/// A disciplina de intervalo (`-1` para `sram`, `0..3` para `state`) é da
/// aplicação, não do banco — um `CHECK` pegaria a violação um pouco antes,
/// mas editar SQL de migration à mão, fora do que `schema.prisma` declara, se
/// perde na próxima vez que alguém rodar `prisma migrate dev` e o shadow
/// database recalcular o diff sem saber do `CHECK` manual. A aplicação
/// (`UserSaveRepository.gravar`) é o lugar que já valida isso.
///
/// ## `thumbnailKey`: nulo para `sram`, populado por upload de `state`
///
/// A miniatura é imagem — não cabe embutida na linha como os poucos bytes de
/// SRAM cabem. `thumbnailKey` aponta pro mesmo storage de objeto que
/// `storageKey` já usa (reaproveitado, não uma segunda porta); fica nulo
/// enquanto não existir upload de `state` nenhum, e a leitura da miniatura
/// separada dos bytes do estado (ADR 0020, `readThumbnail`) é exatamente o
/// que motiva ela morar numa chave própria em vez de ir dentro do mesmo
/// objeto do estado.
///
/// ## `thumbnailSizeBytes`: por que existe uma coluna só para isto (issue #109)
///
/// `medirUso` (cota, #93/#109) soma `sizeBytes` de todas as linhas da conta —
/// mas a miniatura de um save state é um SEGUNDO objeto no storage, com
/// tamanho próprio, que `sizeBytes` nunca descreveu (ele é sempre o tamanho
/// do estado ou da SRAM, nunca da miniatura). Sem uma coluna para o tamanho
/// dela, a cota subestimaria o uso real de quem tem save state — e o
/// critério de aceite da #109 pede explicitamente recusar upload quando SÓ a
/// miniatura estoura, o que não tem como acontecer sem o número dela em
/// algum lugar consultável sem baixar o objeto do storage. Nulo para `sram`
/// e para `state` sem miniatura (não existe hoje — a #105 já torna a
/// miniatura obrigatória no contrato, mas a coluna sendo nullable evita
/// acoplar essa regra de aplicação a uma constraint de banco, mesmo
/// raciocínio do `thumbnailKey`).
model UserSave {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  sha256             String
  kind               SaveKind @default(sram)
  /// `-1` para `sram` (sem slot); `0` a `3` para `state`. Ver o comentário do
  /// model — nunca `null`, de propósito.
  slot               Int      @default(-1)
  storageKey         String   @map("storage_key")
  sizeBytes          Int      @map("size_bytes")
  /// Só para `kind = state`. Ver o comentário do model.
  thumbnailKey       String?  @map("thumbnail_key")
  /// Só para `kind = state` com miniatura. Ver o comentário do model.
  thumbnailSizeBytes Int?     @map("thumbnail_size_bytes")
  revision           Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  userRom UserRom @relation(fields: [userId, sha256], references: [userId, sha256], onDelete: Cascade)

  /// Um save por conta, por conteúdo, por tipo, por slot — a chave que
  /// `buscarPorRom` e a gravação (#89 para SRAM, #105 para state) batem.
  @@unique([userId, sha256, kind, slot])
  @@index([userId])
  @@map("user_saves")
}

/// Papel de uma chave contada em `auth_attempts`. Dois eixos que não se
/// substituem: só por IP não segura ataque distribuído (muitos IPs, uma
/// conta), e só por identificador deixa um atacante negar acesso a uma
/// vítima escolhida. Ver docs/adr/0019.
enum AuthAttemptKey {
  ip
  identifier
}

/// Superfície de credencial em que a tentativa aconteceu. Contadores
/// separados por escopo de propósito: quem errou a senha atual numa troca
/// não deve consumir a cota de quem está tentando entrar.
enum AuthAttemptScope {
  login
  register
  change_password
  forgot_password
}

/// Tentativa de autenticação — uma linha por requisição que chega a uma rota
/// onde credencial é testada. É o contador de rate limit, e ele mora no
/// PostgreSQL porque é a única peça de estado que as instâncias da API já
/// compartilham. Ver docs/adr/0019.
///
/// `keyHash` é o HMAC-SHA256 do IP ou do identificador tentado, nunca o valor
/// em claro: a contagem só precisa de igualdade, e um dump desta tabela não
/// pode virar a lista de quem estava sendo atacado. Senha não chega aqui de
/// forma nenhuma.
model AuthAttempt {
  id        String           @id @default(uuid()) @db.Uuid
  scope     AuthAttemptScope
  keyType   AuthAttemptKey   @map("key_type")
  keyHash   String           @map("key_hash")
  createdAt DateTime         @default(now()) @map("created_at")

  /// A ordem serve à única consulta que decide alguma coisa: contar as
  /// tentativas de uma chave dentro da janela.
  @@index([scope, keyType, keyHash, createdAt])
  /// Poda por idade, que não passa por chave nenhuma.
  @@index([createdAt])
  @@map("auth_attempts")
}
