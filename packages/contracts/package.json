    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@pixelvault/config": "workspace:*",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
