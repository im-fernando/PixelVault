# ─── Banco ────────────────────────────────────────────────────────────────
# Corresponde ao serviço `postgres` do docker-compose.yml.
# Porta 5437 (e não 5432) para não colidir com outros projetos na mesma máquina.
DATABASE_URL="postgresql://pixelvault:pixelvault@localhost:5437/pixelvault?schema=public"

# ─── API ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3333
API_HOST="0.0.0.0"
# Origem do front-end autorizada no CORS
WEB_ORIGIN="http://localhost:5173"
# Segredo de assinatura de sessão e de token de sessão de jogo.
# Gere o seu:  openssl rand -base64 48
SESSION_SECRET="troque-isto-em-qualquer-ambiente-que-nao-seja-o-seu-notebook"

# ─── E-mail transacional ──────────────────────────────────────────────────
# Como o e-mail sai daqui: "console" escreve a mensagem no terminal (com o
# link de redefinição destacado) e não fala com a rede; "resend" manda de
# verdade. Omitido, o padrão vem do NODE_ENV: resend em produção, console em
# qualquer outro ambiente. Ver docs/adr/0021.
EMAIL_TRANSPORTE="console"
# Remetente das mensagens. Em produção precisa ser de um domínio verificado
# no provedor, com SPF, DKIM e DMARC publicados — sem isso o e-mail chega no
# spam, que é pior do que não chegar.
EMAIL_REMETENTE="PixelVault <nao-responda@pixelvault.dev>"
# Obrigatória quando EMAIL_TRANSPORTE="resend". Pegue a sua em
# https://resend.com/api-keys — e nunca a coloque num arquivo versionado.
RESEND_API_KEY="re_troque_isto_pela_sua_chave"

# ─── Capa de jogo comercial reconhecido ───────────────────────────────────
# De onde sai a capa quando o hash da ROM enviada casa com um jogo do
# catálogo que ainda não tem uma: "libretro" pergunta ao servidor de
# thumbnails da comunidade libretro (thumbnails.libretro.com) e guarda a URL
# encontrada em games.cover_url; "desligada" não fala com a rede. Omitida, o
# padrão vem do NODE_ENV: desligada em teste, libretro em qualquer outro
# ambiente. A busca nunca bloqueia o upload — roda por fora dele, e jogo sem
# capa encontrada continua funcionando sem capa.
CAPA_TRANSPORTE="libretro"

# ─── Storage S3-compatible ────────────────────────────────────────────────
# Em desenvolvimento aponta para o MinIO do docker-compose; em produção, R2.
# Todas obrigatórias: sem elas a API não sobe. ROM e save vivem aqui, não no
# banco. A validade das URLs assinadas não é variável de ambiente — é constante
# no código, em apps/api/src/infrastructure/storage/armazenamento-de-objetos.ts.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="pixelvault-dev"
S3_ACCESS_KEY_ID="pixelvault"
S3_SECRET_ACCESS_KEY="pixelvault"
# MinIO exige path-style; R2 e S3 não.
S3_FORCE_PATH_STYLE=true

# ─── Front-end (Vite) ─────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3333"
