# ─── Banco ────────────────────────────────────────────────────────────────
# Corresponde ao serviço `postgres` do docker-compose.yml.
# Porta 5437 (e não 5432) para não colidir com outros projetos na mesma máquina.
DATABASE_URL="postgresql://pixelvault:pixelvault@localhost:5437/pixelvault?schema=public"

# ─── API ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3333
API_HOST="0.0.0.0"
# Origem do front-end autorizada no CORS
WEB_ORIGIN="http://localhost:5173"
# Segredo de assinatura de sessão e de token de sessão de jogo.
# Gere o seu:  openssl rand -base64 48
SESSION_SECRET="troque-isto-em-qualquer-ambiente-que-nao-seja-o-seu-notebook"

# ─── Storage S3-compatible ────────────────────────────────────────────────
# Em desenvolvimento aponta para o MinIO do docker-compose; em produção, R2.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="pixelvault-dev"
S3_ACCESS_KEY_ID="pixelvault"
S3_SECRET_ACCESS_KEY="pixelvault"
# MinIO exige path-style; R2 e S3 não.
S3_FORCE_PATH_STYLE=true

# ─── Front-end (Vite) ─────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3333"
